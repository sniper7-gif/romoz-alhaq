generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ActiveSession {
  id           String   @id @default(uuid()) @db.Uuid
  userCodename String   @unique @map("user_codename")
  role         String
  lastSeen     DateTime @default(now()) @map("last_seen") @db.Timestamptz
  publicKey    String?  @map("public_key")

  @@map("active_sessions")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  senderCodename String   @map("sender_codename")
  role           String
  cipherText     String?  @map("cipher_text")
  iv             String?
  audioUrl       String?  @map("audio_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("messages")
}

model Location {
  id           String   @id @default(uuid()) @db.Uuid
  userCodename String   @unique @map("user_codename")
  role         String
  lat          Float
  lng          Float
  accuracy     Float?
  heading      Float?
  speed        Float?
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("locations")
}
